# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://dfqlceckugfsyeozhbby.supabase.co
# Use the publishable key from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use the anon key instead (leave publishable key empty).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Fixed trusted origin for confirmation emails. Set to your HTTPS deployment origin in production.
SITE_URL=http://localhost:3000
# No service-role/secret credential is required by this application.
# Never place a privileged key in a NEXT_PUBLIC variable.
